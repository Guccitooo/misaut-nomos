---
/** Pictogrammes diététiques (décoratifs : le libellé texte est toujours affiché à côté). */
import type { DietaryTag } from '../content/menu';

interface Props {
  tag: DietaryTag;
}
const { tag } = Astro.props;
const chilis = tag === 'spicy3' ? 3 : tag === 'spicy2' ? 2 : tag === 'spicy1' ? 1 : 0;
---

<span class="diet" aria-hidden="true">
  {
    chilis > 0 ? (
      Array.from({ length: chilis }).map(() => (
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5.5 5.2c1.9.2 3.1 1.6 3.4 3.8.3 2.3 1.6 3.9 3.9 4.6-3.6.8-7.6-1-8.3-4.9-.3-1.5.1-2.9 1-3.5Z" />
          <path d="M5.5 5.2c-.2-1.2.4-2.3 1.6-2.7M6.9 2.4l1.3-.9" />
        </svg>
      ))
    ) : tag === 'vegetarian' ? (
      <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 13c0-5.5 3.5-9 10-10 0 6.5-3.5 10-9 10Z" />
        <path d="M3 13l6-6" />
      </svg>
    ) : tag === 'vegan' ? (
      <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8 14V8" />
        <path d="M8 8C8 5 6 3.5 2.5 3.5 2.5 6.5 4.5 8 8 8Z" />
        <path d="M8 9.5c0-2.6 1.8-4 5.5-4 0 2.7-1.8 4-5.5 4Z" />
      </svg>
    ) : tag === 'containsNuts' ? (
      <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8 2.5c3 0 5 2.4 5 5.3 0 3.2-2.3 5.7-5 5.7s-5-2.5-5-5.7C3 4.9 5 2.5 8 2.5Z" />
        <path d="M8 2.5v11M5.2 6.5h5.6" />
      </svg>
    ) : (
      <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8 14V3.5M8 6 6 4.3M8 6l2-1.7M8 9 6 7.3M8 9l2-1.7M8 12l-2-1.7M8 12l2-1.7" />
        <path d="M3 13 13 3" />
      </svg>
    )
  }
</span>

<style>
  .diet {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1px;
    min-inline-size: 1.6rem;
    block-size: 1.6rem;
    padding-inline: 0.3rem;
    border: 1px solid var(--line-gold);
    border-radius: var(--radius-pill);
    color: var(--gold-300);
  }
</style>
