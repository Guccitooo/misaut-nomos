---
/**
 * Services (salon privé, plats végans…) — PRÊT MAIS ÉTEINT.
 * Ne s'affiche que si `site.services` est montrable (show !== false, et confirmé en launch).
 * Aujourd'hui show=false : ce composant ne rend rien, même en preview.
 */
import { visible } from '../lib/data';
import { useT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const services = visible.services;
---

{
  services && services.length > 0 && (
    <div class="services">
      <p class="eyebrow">{t('services.title')}</p>
      <ul role="list">
        {services.map((s) => (
          <li>{t(`services.${s}`)}</li>
        ))}
      </ul>
    </div>
  )
}

<style>
  .services {
    display: grid;
    gap: 0.75rem;
  }

  .services ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }

  .services li {
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--line-gold);
    border-radius: var(--radius-pill);
    font-size: 0.875rem;
    color: var(--sand-300);
  }
</style>
